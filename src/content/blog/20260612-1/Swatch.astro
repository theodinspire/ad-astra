---
interface Props {
	id: string;
	class: string;
	short: boolean;
	scroll: boolean;
}

const { id, class: className, short, scroll, ...rest } = Astro.props;

const height = short ? 'h-20' : 'h-80 sm:h-40';

const outerClassList = [
	'outer',
	'my-2 w-full lg:w-120 mx-auto relative rounded-sm overflow-scroll',
	height,
	className,
];

if (short) outerClassList.push('short');
---

<div id={id} class={outerClassList.join(' ')}>
	{
		Astro.slots.has('default') && (
			<div class="copy sticky flex size-full items-center justify-center text-4xl italic">
				<div>
					<slot />
				</div>
			</div>
		)
	}
	{scroll && <div class="scroller z-1 h-5/1" />}
</div>

<style>
	.copy {
		font-family: 'Agency FB', sans-serif;
	}
</style>
