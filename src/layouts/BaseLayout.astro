---
import Foundation from './Foundation.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { pageTitle, inSpace } = Astro.props;
const showHero = Astro.slots.has('default') && !inSpace;

const mainClasses = `main m-4 rounded-2xl p-4 lg:p-8 ${showHero && 'bg-core-50'}`;
---

<Foundation>
	<Header />
	<h1 class="title text-core-200 m-4 text-7xl">{pageTitle}</h1>
	<div class={mainClasses}>
		<slot />
	</div>
	<Footer />
</Foundation>
