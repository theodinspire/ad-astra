---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { pageTitle, inSpace } = Astro.props;
const showHero = Astro.slots.has('default') && !inSpace;

const mainClasses = `main m-4 rounded-2xl p-4 lg:p-8 ${showHero && 'bg-core-50'}`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>theodinspire</title>
	</head>
	<body class="lg:max-w-300">
		<Header />

		<h1 class="title text-core-200 m-4">{pageTitle}</h1>
		<div class={mainClasses}>
			<slot />
		</div>
		<Footer />
		<script>
			import '../scripts/menu.js';
		</script>
	</body>
</html>
