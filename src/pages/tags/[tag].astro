---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogSummary from '@components/BlogSummary.astro';
import { getCollection } from 'astro:content';

export const getStaticPaths = async () => {
	const allPosts = await getCollection('blog');
	const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

	return uniqueTags.map((tag) => {
		const posts = allPosts.filter((post) => post.data.tags?.includes(tag));
		return {
			params: { tag },
			props: { posts },
		};
	});
};

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={tag}>
	<p>Posts tagged with <em>{tag}</em></p>
	<ul>
		{posts.map((post) => <BlogSummary id={post.id} title={post.data.title} />)}
	</ul>
</BaseLayout>
