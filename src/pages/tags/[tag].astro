---
import BaseHeroLayout from '@layouts/BaseHeroLayout.astro';
import BlogSummary from '@components/BlogSummary.astro';
import { type CollectionEntry, getCollection } from 'astro:content';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

export const getStaticPaths = async () => {
	const allPosts = (await getCollection('blog'));
	const uniqueTags = [...new Set(allPosts.flatMap((post) => post.data.tags))];

	return uniqueTags.map((tag) => {
		const posts = allPosts.filter((post) => post.data.tags?.includes(tag));
		return {
			params: { tag },
			props: { posts },
		};
	});
};

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseHeroLayout pageTitle={tag}>
	<p>Posts tagged with <em>{tag}</em></p>
	<ul>
		{posts
			.sort((left, right) => right.data.pubDate - left.data.pubDate).map((post) => <BlogSummary id={post.id} title={post.data.title} />)}
	</ul>
</BaseHeroLayout>
