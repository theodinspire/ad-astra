---
import BaseLayout from '@layouts/BaseLayout.astro';
import '@styles/global.css';
import BlogSummary from '@components/BlogSummary.astro';
import { type CollectionEntry, getCollection } from 'astro:content';

const allPosts = (await getCollection('blog') as CollectionEntry<'blog'>[])
	.sort((left, right) => right.data.pubDate - left.data.pubDate);

const pageTitle = 'Blog';
---

<BaseLayout pageTitle={pageTitle}>
	<div class="main">
		<ul class="list-disc marker:text-core-500">
			{
				allPosts.map((post) => (
					<BlogSummary id={post.id} title={post.data.title} />
				))
			}
		</ul>
	</div>
</BaseLayout>
